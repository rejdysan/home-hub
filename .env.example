# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password
MQTT_KEEPALIVE=60

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Keys
GOLEMIO_API_KEY=your_golemio_api_key_here
TODOIST_API_KEY=your_todoist_api_key_here

# Location (latitude,longitude for weather)
LOCATION_LATITUDE=50.0878433
LOCATION_LONGITUDE=14.478581

# Todoist Project IDs
TODOIST_PROJECT_1=your_project_id_1
TODOIST_PROJECT_2=your_project_id_2

# Update Intervals (in seconds)
WEATHER_UPDATE_INTERVAL=300
NAMEDAY_UPDATE_INTERVAL=3600
BUS_UPDATE_INTERVAL=10
# System monitoring: 5 seconds is good balance for Raspberry Pi (less CPU overhead)
SYSTEM_MONITOR_INTERVAL=5
GOOGLE_MAPS_UPDATE_INTERVAL=60
GOOGLE_CALENDAR_UPDATE_INTERVAL=300
TODOIST_UPDATE_INTERVAL=60

# NHL tile (rotating scores / standings / bracket / leaders)
NHL_TILE_ROTATE_INTERVAL=10
NHL_UPDATE_INTERVAL=300
NHL_LIVE_UPDATE_INTERVAL=60
NHL_STANDINGS_UPDATE_INTERVAL=1800
NHL_LEADERS_UPDATE_INTERVAL=3600
# Optional season override for testing, e.g. 20252026 (empty = current season)
NHL_SEASON=

# Photo tile (day mode): random photos. See doc/deployment.md "Photo tile".
# Folder on the Pi with photos (relative to the project, or absolute); subfolder names become captions
PHOTOS_DIR=photos
# Optional Google Drive folder ID (the part after /folders/ in its URL), shared with the
# service account from GOOGLE_SERVICE_ACCOUNT_FILE. Leave empty to use only PHOTOS_DIR.
PHOTOS_DRIVE_FOLDER_ID=
# Where the Pi keeps the display-sized copies the tile loads
PHOTOS_CACHE_DIR=photo_cache
PHOTOS_MAX_EDGE=1600
PHOTOS_SCAN_INTERVAL=900
PHOTOS_TILE_ROTATE_INTERVAL=20

# Kiosk modes (HH:MM format)
MORNING_MODE_START=05:30
DAY_MODE_START=08:00
NIGHT_MODE_START=22:00

# MQTT Throttle
MQTT_SAVE_THROTTLE=5
SENSOR_OFFLINE_TIMEOUT=30
SENSOR_STATUS_CHECK_INTERVAL=5

# Database
DB_NAME=sensors.db
DB_CLEANUP_DAYS=30
DB_CLEANUP_HOUR=3

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

